# Init image: rotation limits come from GRAYLOG_INDEX_MAX_SIZE_BYTES and
# GRAYLOG_INDEX_MAX_INDICES at run time. They are not copied into the image.
FROM alpine:3.22
RUN apk add --no-cache curl jq
COPY graylog-index-set-merge.jq /opt/graylog-init/index-set-merge.jq
COPY graylog-index-set-patch.sh /opt/graylog-init/index-set-patch.sh
COPY graylog-init.sh /opt/graylog-init/graylog-init.sh
RUN chmod +x /opt/graylog-init/graylog-init.sh /opt/graylog-init/index-set-patch.sh \
    && grep -q 'INIT_SCRIPT_REV=6' /opt/graylog-init/graylog-init.sh \
    && grep -q 'GRAYLOG_INDEX_MAX_SIZE_BYTES' /opt/graylog-init/index-set-patch.sh
ENTRYPOINT ["/bin/sh", "/opt/graylog-init/graylog-init.sh"]
